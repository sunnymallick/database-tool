{
  "name": "database-tool",
  "productName": "Database Tool",
  "version": "0.1.0",
  "description": "Desktop database client for PostgreSQL, MySQL, SQL Server and SQLite with an embedded Claude agent",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Sunny Mallick",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "svelte-check --tsconfig ./tsconfig.web.json --threshold error",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "test:e2e": "pnpm build && node tests/e2e/smoke.mjs && node tests/e2e/files.mjs",
    "package:mac": "pnpm build && electron-builder --mac --dir",
    "test:tour": "pnpm build && node tests/e2e/ui-tour.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@anthropic-ai/sdk": "^0.133.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "mssql": "^12.7.6",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "sql-formatter": "^15.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@internationalized/date": "^3.12.4",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.56.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fflate": "^0.8.3",
    "playwright": "^1.64.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
